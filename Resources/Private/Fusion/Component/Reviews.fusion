prototype(UpAssist.Neos.GoogleReviews:Component.Reviews) < prototype(Neos.Fusion:Component) {
    placeId = ''
    showAuthorPhoto = true
    maxDisplayedReviews = 5
    showAllReviewsLink = true

    reviews = ${GoogleReviews.getReviews(props.placeId)}
    allReviewsUrl = ${'https://search.google.com/local/reviews?placeid=' + props.placeId}

    renderer = afx`
        <div class="google-reviews" @if={props.reviews} style={'--reviews-count: ' + props.maxDisplayedReviews}>
            <link rel="stylesheet" href={StaticResource.uri('UpAssist.Neos.GoogleReviews', 'Public/Styles/reviews.css')} />
            <div class="google-reviews__grid">
                <Neos.Fusion:Loop items={props.reviews} itemName="review" iterationName="iterator">
                    <UpAssist.Neos.GoogleReviews:Component.ReviewCard
                        @if={iterator.index < props.maxDisplayedReviews}
                        authorName={review.authorName}
                        rating={review.rating}
                        text={review.text}
                        relativePublishTime={review.relativePublishTime}
                        profilePhotoUrl={review.profilePhotoUrl}
                        showAuthorPhoto={props.showAuthorPhoto}
                    />
                </Neos.Fusion:Loop>
            </div>
            <div class="google-reviews__footer" @if={props.showAllReviewsLink && props.placeId}>
                <a href={props.allReviewsUrl} target="_blank" rel="noopener noreferrer" class="google-reviews__all-link">
                    Bekijk alle reviews op Google
                </a>
            </div>
        </div>
    `
}
